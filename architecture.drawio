        <!-- Flow Legend -->
        <mxCell id="legend" value="Request Flow:&#xa;1. User opens liveness.demo12.online (Route 53 → CloudFront → S3)&#xa;2. Authenticates via Cognito, gets temp AWS creds from Identity Pool&#xa;3. API Gateway routes to Lambda functions&#xa;4. Lambda calls Rekognition for face analysis&#xa;5. Results persisted to DynamoDB, frames/video to S3" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=#BDBDBD;fillColor=#FAFAFA;fontSize=10;fontColor=#424242;rounded=1;spacing=6;" vertex="1" parent="1">
