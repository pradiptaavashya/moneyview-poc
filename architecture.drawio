          <mxGeometry x="325" y="690" width="370" height="25" as="geometry" />
        </mxCell>
        <mxCell id="antifraud-content" value="Layer 1: Client-Side Preflight — Virtual cam, headless browser, screen share detection&#xa;Layer 2: AWS Rekognition Face Liveness — Colored light 3D depth analysis (WebRTC streaming)&#xa;Layer 3: Randomized Gesture Challenges — Server-validated head pose + expression (DetectFaces)&#xa;Layer 4: Face Comparison — Live capture vs uploaded ID document (CompareFaces)&#xa;Layer 5: AI Watermark Detection — Reject AI-generated reference documents&#xa;Layer 6: Full Session Recording — Video stored in S3 for audit/manual review" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#424242;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="325" y="720" width="500" height="110" as="geometry" />
        </mxCell>

